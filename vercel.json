{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/for-employers", "destination": "/#employers", "permanent": false }
  ],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/volta", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
